<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background layer: a deep navy gradient that keeps the
    launcher icon readable on both light and dark wallpapers.
    Keep in sync with warpgate/design/ic_launcher.svg.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF18243F" />
                <item android:offset="1" android:color="#FF070B14" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
