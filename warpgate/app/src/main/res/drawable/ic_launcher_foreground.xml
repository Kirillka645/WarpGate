<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground layer: a shield (protection) with a knocked-out
    lightning bolt (WARP / speed). The bolt is a hole in the shield thanks to
    the even-odd fill rule, so the background layer shows through and the icon
    stays a single clean silhouette at 48 dp.

    The artwork stays inside the 66 dp safe zone so no launcher mask clips it.
    Keep in sync with warpgate/design/ic_launcher.svg.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillType="evenOdd"
        android:pathData="M54,23.2 C63.3,23.2 71.7,26.2 77.2,28.7 L77.2,50.6 C77.2,64.6 67.5,78.5 55.7,85.6 C54.9,86.1 53.1,86.1 52.3,85.6 C40.5,78.5 30.8,64.6 30.8,50.6 L30.8,28.7 C36.3,26.2 44.7,23.2 54,23.2 Z M60.3,33.8 L44.7,58.6 L52.7,58.6 L49.4,78.5 L67.1,52.7 L57.8,52.7 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="33"
                android:startY="23"
                android:endX="74"
                android:endY="86">
                <item android:offset="0" android:color="#FF8AB0FF" />
                <item android:offset="0.5" android:color="#FF4F7CFF" />
                <item android:offset="1" android:color="#FF9B5CFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
